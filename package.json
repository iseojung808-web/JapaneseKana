{
  "name": "kana-trainer",
  "version": "1.0.0",
  "description": "A spaced-repetition trainer for Japanese hiragana and katakana.",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node -e \"require('http').createServer((q,s)=>{const f=require('fs'),p=require('path'),u=q.url==='/'?'/index.html':q.url.split('?')[0],x=p.join(process.cwd(),u);f.readFile(x,(e,d)=>{if(e){s.writeHead(404);return s.end('not found')}s.writeHead(200,{'content-type':{'.html':'text/html','.css':'text/css','.js':'text/javascript'}[p.extname(x)]||'text/plain'});s.end(d)})}).listen(8080,()=>console.log('http://localhost:8080'))\""
  },
  "license": "MIT"
}
